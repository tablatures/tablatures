<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: verified https deep links for tablatures.org
                 (all paths). autoVerify requires .well-known/assetlinks.json with
                 this app's signing fingerprint to be served on the domain — see
                 docs/app-links.md. Capacitor surfaces the opened URL via the App
                 plugin's `appUrlOpen` event, routed into the SPA router. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="tablatures.org" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Writing a downloaded tab into the public Documents collection.
         Directory.Documents is a PUBLIC directory, so on API < 30 the Filesystem
         plugin gates the write behind these two. They were not declared, and
         requesting a permission the manifest does not declare returns DENIED
         immediately with no dialog, so "Download" could never succeed on Android
         7 to 10. API 30+ needs neither, hence maxSdkVersion. downloadFile() also
         falls back to the share sheet if the write still fails. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Microphone for the guitar tuner (getUserMedia). Capacitor bridges the
         runtime permission prompt automatically. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Haptic feedback (loop-select long-press). -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
