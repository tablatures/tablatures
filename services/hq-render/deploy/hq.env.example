# Render service settings (see hqrender/service.py, storage.py and render.py for all of them)
HQ_HOST=0.0.0.0
HQ_PORT=8790
HQ_REPO=@HOME@/tabrender/app
HQ_ASSETS=@HOME@/tabrender/assets
HQ_SFIZZ=@HOME@/tabrender/opt/bin/sfizz_render
HQ_STATE_DIR=@HOME@/tabrender/state
HQ_DISABLED_FILE=@HOME@/tabrender/DISABLED
# one amp process: leaves the host's other services room
HQ_AMP_WORKERS=1
HQ_AMP_CHUNK_S=10
HQ_DAILY_RENDERS=40
HQ_QUEUE_MAX=50
HQ_STORAGE_CAP_GB=8
HQ_MIN_FREE_GB=4
HQ_HOT_C=70
HQ_COOL_C=60
HQ_ALLOWED_ORIGINS=*
# Storage: local files served by this service, or any S3-compatible bucket (R2, S3, B2, MinIO)
HQ_STORAGE=local
HQ_STORAGE_DIR=@HOME@/tabrender/files
# HQ_STORAGE=s3
# HQ_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# HQ_S3_BUCKET=tablatures-hq
# HQ_S3_KEY_ID=
# HQ_S3_SECRET=
# the code directory is read-only under systemd
NUMBA_CACHE_DIR=@HOME@/tabrender/state/numba
PYTHONDONTWRITEBYTECODE=1
